<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ filename }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
{% include "style.css.j2" %}
    .badge { background: #f0e8ff; color: #5b21b6; }
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

<div class="topbar">
  {% for crumb in breadcrumbs %}
    {% if not loop.last %}
    <a href="{{ crumb.link }}">{{ crumb.name }}</a>
    <span class="sep">›</span>
    {% else %}
    <span class="filename">{{ filename }}</span>
    {% endif %}
  {% endfor %}
</div>

<div class="content">

  <div class="thumb-col">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ filename }}" />
    {% else %}
    <div class="no-thumb">No preview</div>
    {% endif %}

    <div class="file-meta">
      <table>
        <tr><td>Format</td><td>DXF (ASCII)</td></tr>
        {% if details.acad_version %}
        <tr><td>AutoCAD ver.</td><td>{{ details.acad_version }}{% if details.acad_version_name %} (R{{ details.acad_version_name }}){% endif %}</td></tr>
        {% endif %}
        <tr><td>Modified</td><td>{{ modified }}</td></tr>
        <tr><td>Size</td><td>{{ file_size }}</td></tr>
      </table>
    </div>
  </div>

  <div class="detail-col">
    <h1>{{ filename }}</h1>
    <span class="badge">DXF</span>

    {% if details.error %}
    <div class="error-box">Could not parse DXF: {{ details.error }}</div>
    {% else %}

    {% if details.size_x or details.size_y %}
    <div class="section">
      <h2>Dimensions</h2>
      <div class="stat-row">
        {% if details.size_x %}
        <div class="stat-box">
          <div class="val">{{ details.size_x }}</div>
          <div class="lbl">Width (X)</div>
        </div>
        {% endif %}
        {% if details.size_y %}
        <div class="stat-box">
          <div class="val">{{ details.size_y }}</div>
          <div class="lbl">Height (Y)</div>
        </div>
        {% endif %}
        {% if details.size_z and details.size_z != "0.00" %}
        <div class="stat-box">
          <div class="val">{{ details.size_z }}</div>
          <div class="lbl">Depth (Z)</div>
        </div>
        {% endif %}
      </div>
      <div class="unit-note">Dimensions in drawing units. Check the file's header or original application for the unit system (mm, inches, etc.).</div>
    </div>
    {% endif %}

    {% if details.total_entities %}
    <div class="section">
      <h2>Entities</h2>
      <div class="stat-row" style="margin-bottom:12px;">
        <div class="stat-box">
          <div class="val">{{ details.total_entities }}</div>
          <div class="lbl">Total entities</div>
        </div>
        {% if details.total_length %}
        <div class="stat-box">
          <div class="val">{{ details.total_length }}</div>
          <div class="lbl">Est. total length</div>
        </div>
        {% endif %}
      </div>
      <div class="chips">
        {% for etype, count in details.entity_counts.items() %}
        <div class="chip">{{ etype }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.length_by_type %}
    <div class="section">
      <h2>Estimated length by type</h2>
      <table class="kv-table">
        <tbody>
          {% for etype, length in details.length_by_type.items() %}
          <tr>
            <td>{{ etype }}</td>
            <td>{{ length }} units</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="unit-note">Lengths in drawing units. Lines, polylines, circles, arcs, and ellipses are measured. Splines and other entities are not included.</div>
    </div>
    {% endif %}

    {% if details.layers %}
    <div class="section">
      <h2>Layers</h2>
      <table class="layers-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Color</th>
            <th>Linetype</th>
            <th>Entities</th>
          </tr>
        </thead>
        <tbody>
          {% for layer in details.layers %}
          <tr>
            <td>{{ layer.name }}</td>
            <td>
              {% if layer.color is defined and layer.color is not none %}
              <span class="color-swatch" style="background:{{ layer.color | dxf_aci_css }}"></span>{{ layer.color }}
              {% endif %}
            </td>
            <td>{{ layer.linetype or '' }}</td>
            <td>{{ details.entities_by_layer.get(layer.name, '') }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if details.entities_by_layer and not details.layers %}
    <div class="section">
      <h2>Entities by layer</h2>
      <div class="chips">
        {% for layer_name, count in details.entities_by_layer.items() %}
        <div class="chip">{{ layer_name }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.texts %}
    <div class="section">
      <h2>Text content</h2>
      <ul class="text-list">
        {% for t in details.texts %}
        <li>{{ t }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% endif %}
  </div>
</div>

<script>
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
