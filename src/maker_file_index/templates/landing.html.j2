<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Maker File Index</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
{% include "style.css.j2" %}
  </style>
</head>
<body>

<nav class="topnav">
  <div style="display:flex;align-items:baseline;gap:12px;">
    <a class="topnav-brand" href="index.html">Maker File Index</a>
    {% if generated_at %}<span style="font-size:12px;color:var(--text-muted);">{{ generated_at }}</span>{% endif %}
  </div>

  <div class="topnav-right">
    <button class="sidebar-toggle" id="sidebar-toggle-btn" onclick="toggleSidebar()">&#9776; Sidebar</button>
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

{% macro render_tree(nodes) -%}
<ul>
  {%- for n in nodes %}
  <li{% if n.children and n.children|length %} class="collapsed"{% endif %}>
    {%- if n.children and n.children|length %}
    <span class="toggle" onclick="toggleTree(this)">&#9654;</span>
    {%- else %}
    <span class="spacer"></span>
    {%- endif %}
    <a href="{{ n.link }}">{{ n.name }}</a>
    {%- if n.children and n.children|length %}
      {{ render_tree(n.children) }}
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
{%- endmacro %}

<div class="layout" id="layout">

  <aside class="sidebar">
    {% if page_types %}
    <div class="type-filters">
      <div class="flabel">File types</div>
      {% for t in page_types %}
      <button class="type-btn" data-key="{{ t.key }}" onclick="toggleSideType(this)">{{ t.label }}</button>
      {% endfor %}
    </div>
    {% endif %}

    {% if tree_data %}
    <div class="tree">
      {{ render_tree(tree_data) }}
    </div>
    {% endif %}
  </aside>

  <main class="main">
    <div class="hero">
      <!-- <h1>Maker File Index</h1>
      <div class="subtitle">Generated: {{ generated_at }}</div>
	  -->
      <div class="stats">
        <div class="stat">&#128194; <strong>{{ total_dirs }}</strong> directories</div>
        <div class="stat">&#128196; <strong>{{ total_files }}</strong> files</div>
        <button class="stat-btn active" id="btn-all" onclick="clearFilter()">All</button>
        {% for t in type_stats %}
        {%- set badge_cls = {"lightburn": "badge-lbrn2", "stl": "badge-stl", "openscad": "badge-scad", "3mf": "badge-3mf", "svg": "badge-svg", "dxf": "badge-dxf", "cdr": "badge-cdr"}.get(t.key, "badge-default") %}
        <button class="stat-btn" data-key="{{ t.key }}" onclick="toggleType(this)"><span class="badge {{ badge_cls }}">{{ t.label }}</span> <strong>{{ t.count }}</strong></button>
        {% endfor %}
      </div>
    </div>

    <div class="filter-sort-row">
      <input type="search" id="page-filter" placeholder="Filter directories and files…" oninput="filterCards(this.value)" />
      <div class="sort-btns">
        <button class="sort-btn" data-sort="recent" onclick="setSort('recent')">Recent</button>
        <button class="sort-btn" data-sort="alpha"  onclick="setSort('alpha')">Name</button>
      </div>
    </div>

    <div id="files-section">
      <div id="dir-results-section" style="display:none; margin-bottom:16px;">
        <h2>Directories <span id="dirs-count"></span></h2>
        <div id="dir-results-list"></div>
      </div>
      <div id="file-results-section" style="display:none;">
        <h2>Files <span id="files-count"></span></h2>
        <div id="files-list"></div>
      </div>
    </div>

    <div class="grid" id="dir-grid">
      {% for d in dirs %}
      <div class="card" data-name="{{ d.name | lower }}" data-labels="{{ d.labels }}" data-mtime="{{ d.mtime }}">
        {% if d.first_thumb %}
          <a href="{{ d.link }}"><img class="thumb" src="{{ d.first_thumb }}" alt="" /></a>
        {% else %}
          <a href="{{ d.link }}"><div class="no-thumb">&#128193;</div></a>
        {% endif %}
        <div class="card-body">
          <div class="card-title"><a href="{{ d.link }}">{{ d.name }}</a></div>
          <div class="card-meta">{{ d.counts }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </main>
</div>

<div class="footer">maker-file-index</div>

<script id="files-data" type="application/json">{{ all_files_json }}</script>
<script>
var activeType = null;
var ALL_FILES = JSON.parse(document.getElementById('files-data').textContent);
var SORT_KEY = 'mfi-sort';
var currentSort = 'recent';
var currentDir = 'desc';
(function() {
  var saved = localStorage.getItem(SORT_KEY) || 'recent-desc';
  var parts = saved.split('-');
  currentSort = parts[0] === 'alpha' ? 'alpha' : 'recent';
  currentDir = parts[1] === 'asc' ? 'asc' : (parts[1] === 'desc' ? 'desc' : (currentSort === 'recent' ? 'desc' : 'asc'));
})();

function sortLabel(key, active, dir) {
  if (!active) return key === 'recent' ? 'Recent' : 'Name';
  if (key === 'recent') return dir === 'desc' ? 'Recent \u25BC' : 'Recent \u25B2';
  return dir === 'asc' ? 'A\u2013Z \u25B2' : 'Z\u2013A \u25BC';
}

function updateSortButtons() {
  document.querySelectorAll('.sort-btn').forEach(function(b) {
    var active = b.dataset.sort === currentSort;
    b.classList.toggle('active', active);
    b.textContent = sortLabel(b.dataset.sort, active, currentDir);
  });
}

function setSort(key) {
  if (currentSort === key) {
    currentDir = currentDir === 'asc' ? 'desc' : 'asc';
  } else {
    currentSort = key;
    currentDir = key === 'recent' ? 'desc' : 'asc';
  }
  localStorage.setItem(SORT_KEY, currentSort + '-' + currentDir);
  updateSortButtons();
  applySortToGrid(document.getElementById('dir-grid'));
}

function applySortToGrid(grid) {
  if (!grid) return;
  var cards = Array.from(grid.querySelectorAll(':scope > .card'));
  cards.sort(function(a, b) {
    var r;
    if (currentSort === 'alpha') {
      r = (a.dataset.name || '').localeCompare(b.dataset.name || '');
    } else {
      r = parseInt(b.dataset.mtime || '0') - parseInt(a.dataset.mtime || '0');
    }
    return currentDir === 'asc' ? -r : r;
  });
  cards.forEach(function(c) { grid.appendChild(c); });
}

(function() {
  updateSortButtons();
  applySortToGrid(document.getElementById('dir-grid'));
})();
var BADGE_CLS = {lbrn2:'badge-lbrn2',lbrn:'badge-lbrn',stl:'badge-stl',scad:'badge-scad','3mf':'badge-3mf',svg:'badge-svg',dxf:'badge-dxf',cdr:'badge-cdr'};

function applyFilters() {
  var q = (document.getElementById('page-filter') ? document.getElementById('page-filter').value : '').toLowerCase().trim();
  document.querySelectorAll('#dir-grid .card').forEach(function(card) {
    var nameMatch = q === '' || card.dataset.name.includes(q);
    var typeMatch = !activeType || (card.dataset.labels || '').split(' ').includes(activeType);
    card.classList.toggle('hidden', !nameMatch || !typeMatch);
  });
  renderFileResults(q);
}

function renderFileResults(q) {
  var section = document.getElementById('files-section');
  if (!q) { section.style.display = 'none'; return; }
  section.style.display = 'block';

  var typeFilter = activeType;
  var dirs = ALL_FILES.filter(function(f) {
    return f.is_dir && f.name.toLowerCase().includes(q) && !typeFilter;
  });
  var files = ALL_FILES.filter(function(f) {
    if (f.is_dir) return false;
    var typeMatch = !typeFilter || f.ext === typeFilter ||
      (typeFilter === 'lightburn' && (f.ext === 'lbrn' || f.ext === 'lbrn2'));
    return f.name.toLowerCase().includes(q) && typeMatch;
  });

  // Directories subsection
  var dirSection = document.getElementById('dir-results-section');
  var dirList = document.getElementById('dir-results-list');
  var dirsCount = document.getElementById('dirs-count');
  if (dirs.length > 0) {
    dirsCount.textContent = '(' + dirs.length + ')';
    dirList.innerHTML = dirs.slice(0, 50).map(function(d) {
      var pathLabel = d.path && d.path !== d.name ? '<span style="color:var(--text-faint);font-size:11px;margin-left:6px;">' + escHtml(d.path) + '</span>' : '';
      var meta = d.counts ? '<span style="color:var(--text-muted);font-size:12px;">' + escHtml(d.counts) + '</span>' : '';
      var thumb = d.thumb
        ? '<img class="file-result-thumb" src="' + d.thumb + '" alt="">'
        : '<div class="file-result-no-thumb" style="font-size:22px;">&#128193;</div>';
      return '<a class="file-result" href="' + d.link + '">'
        + thumb
        + '<div class="file-result-info">'
        + '<div class="file-result-name">&#128193; ' + escHtml(d.name) + pathLabel + '</div>'
        + '<div class="file-result-dir">' + meta + '</div>'
        + '</div></a>';
    }).join('');
    dirSection.style.display = 'block';
  } else {
    dirSection.style.display = 'none';
  }

  // Files subsection
  var fileSection = document.getElementById('file-results-section');
  var fileList = document.getElementById('files-list');
  var countEl = document.getElementById('files-count');
  if (files.length > 0) {
    countEl.textContent = '(' + files.length + ')';
    fileList.innerHTML = files.slice(0, 100).map(function(f) {
      var cls = BADGE_CLS[f.ext] || 'badge-default';
      var thumb = f.thumb
        ? '<img class="file-result-thumb" src="' + f.thumb + '" alt="">'
        : '<div class="file-result-no-thumb"><span class="badge ' + cls + '">' + (f.ext || '?') + '</span></div>';
      var dirLink = f.dir_link
        ? '<a href="' + f.dir_link + '" onclick="event.stopPropagation()">' + escHtml(f.dir_name) + '</a>'
        : escHtml(f.dir_name);
      return '<a class="file-result" href="' + f.link + '">'
        + thumb
        + '<div class="file-result-info">'
        + '<div class="file-result-name">' + escHtml(f.name) + '</div>'
        + '<div class="file-result-dir">' + dirLink + '</div>'
        + '</div></a>';
    }).join('');
    fileSection.style.display = 'block';
  } else {
    fileSection.style.display = 'none';
  }

  if (dirs.length === 0 && files.length === 0) {
    fileSection.style.display = 'block';
    fileList.innerHTML = '<div class="no-results">No results matched.</div>';
    countEl.textContent = '(0)';
  }
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function filterCards(q) { applyFilters(); }

function clearFilter() {
  activeType = null;
  document.querySelectorAll('.stat-btn').forEach(function(b) { b.classList.remove('active'); });
  document.getElementById('btn-all').classList.add('active');
  document.querySelectorAll('.type-btn').forEach(function(b) { b.classList.remove('active'); });
  applyFilters();
}

function toggleType(btn) {
  var key = btn.dataset.key;
  if (activeType === key) { clearFilter(); return; }
  activeType = key;
  document.querySelectorAll('.stat-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('.type-btn').forEach(function(b) {
    b.classList.toggle('active', b.dataset.key === key);
  });
  applyFilters();
}

function toggleSideType(btn) {
  var key = btn.dataset.key;
  if (activeType === key) { clearFilter(); return; }
  activeType = key;
  document.querySelectorAll('.type-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('.stat-btn').forEach(function(b) {
    b.classList.toggle('active', b.dataset.key === key);
  });
  applyFilters();
}

function toggleTree(btn) {
  var li = btn.parentElement;
  li.classList.toggle('collapsed');
  btn.textContent = li.classList.contains('collapsed') ? '\u25B6' : '\u25BC';
}

/* Sidebar toggle */
var SIDEBAR_KEY = 'mfi-sidebar-v2';
function toggleSidebar() {
  var layout = document.getElementById('layout');
  var btn = document.getElementById('sidebar-toggle-btn');
  layout.classList.toggle('sidebar-hidden');
  var hidden = layout.classList.contains('sidebar-hidden');
  localStorage.setItem(SIDEBAR_KEY, hidden ? '0' : '1');
  if (btn) btn.classList.toggle('active', hidden);
}
(function() {
  var saved = localStorage.getItem(SIDEBAR_KEY);
  if (saved === null) { localStorage.setItem(SIDEBAR_KEY, '1'); saved = '1'; }
  if (saved === '0') {
    document.getElementById('layout').classList.add('sidebar-hidden');
    var btn = document.getElementById('sidebar-toggle-btn');
    if (btn) btn.classList.add('active');
  }
})();

/* Theme */
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
