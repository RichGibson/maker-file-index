<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Maker File Index</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 0; background: #f5f5f5; line-height: 1.35; }

    .hero { background: #fff; border-bottom: 1px solid #ddd; padding: 28px 32px 20px; }
    .hero h1 { margin: 0 0 4px; font-size: 1.8rem; }
    .hero .subtitle { color: #666; font-size: 14px; margin-bottom: 16px; }

    /* Summary stats bar */
    .stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
    .stat { background: #f3f3f3; border-radius: 8px; padding: 6px 14px; font-size: 13px; color: #444; }
    .stat strong { color: #111; }

    /* Badge colors (same as dir pages) */
    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.03em; }
    .badge-lbrn2, .badge-lbrn { background: #fff0e0; color: #b05000; }
    .badge-stl  { background: #e0eeff; color: #1a5cbe; }
    .badge-scad { background: #e4f7e4; color: #1d7a1d; }
    .badge-3mf  { background: #ede0ff; color: #6b21a8; }
    .badge-svg  { background: #ffe0f0; color: #b0006a; }
    .badge-dxf  { background: #e0f7f7; color: #0e6868; }
    .badge-default { background: #f0f0f0; color: #555; }

    /* Directory grid */
    .content { padding: 24px 32px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 16px;
    }
    .card {
      border: 1px solid #ddd;
      border-radius: 12px;
      padding: 12px;
      background: #fff;
      transition: box-shadow 0.15s;
    }
    .card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.09); }
    .thumb {
      width: 100%;
      height: 180px;
      border-radius: 8px;
      object-fit: contain;
      background: #f6f6f6;
      border: 1px solid #eee;
    }
    .no-thumb {
      width: 100%;
      height: 180px;
      border-radius: 8px;
      background: #f6f6f6;
      border: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ccc;
      font-size: 28px;
    }
    .card-body { margin-top: 10px; }
    .card-title { font-size: 15px; font-weight: 600; }
    .card-title a { color: inherit; text-decoration: none; }
    .card-title a:hover { text-decoration: underline; }
    .card-meta { margin-top: 4px; font-size: 12px; color: #888; }

    .footer { text-align: center; color: #aaa; font-size: 12px; padding: 24px; }
    .filter-bar { margin: 0 32px 16px; }
    .filter-bar input { width: 100%; max-width: 480px; box-sizing: border-box; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; }
    .filter-bar input:focus { border-color: #aaa; }
    .card.hidden { display: none; }
  </style>
</head>
<body>

<div class="hero">
  <h1>Maker File Index</h1>
  <div class="subtitle">Generated: {{ generated_at }}</div>
  <div class="stats">
    <div class="stat">&#128194; <strong>{{ total_dirs }}</strong> directories</div>
    <div class="stat">&#128196; <strong>{{ total_files }}</strong> files</div>
    {% for ext, count in ext_counts %}
    <div class="stat">
      {% set cls = "badge-" ~ ext if ext in ["lbrn2","lbrn","stl","scad","3mf","svg","dxf"] else "badge-default" %}
      <span class="badge {{ cls }}">{{ ext }}</span> <strong>{{ count }}</strong>
    </div>
    {% endfor %}
  </div>
</div>

<div class="filter-bar">
  <input type="search" id="dir-filter" placeholder="Filter directories…" oninput="filterCards(this.value)" />
</div>

<div class="content">
  <div class="grid" id="dir-grid">
    {% for d in dirs %}
    <div class="card" data-name="{{ d.name | lower }}">
      {% if d.first_thumb %}
        <a href="{{ d.link }}"><img class="thumb" src="{{ d.first_thumb }}" alt="" /></a>
      {% else %}
        <a href="{{ d.link }}"><div class="no-thumb">&#128193;</div></a>
      {% endif %}
      <div class="card-body">
        <div class="card-title"><a href="{{ d.link }}">{{ d.name }}</a></div>
        <div class="card-meta">{{ d.counts }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="footer">maker-file-index</div>

<script>
function filterCards(q) {
  q = q.toLowerCase().trim();
  document.querySelectorAll('.grid .card').forEach(function(card) {
    card.classList.toggle('hidden', q !== '' && !card.dataset.name.includes(q));
  });
}
</script>
</body>
</html>
