<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ filename }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
{% include "style.css.j2" %}
    .badge { background: #e0f0ff; color: #004c99; }
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

<div class="topbar">
  {% for crumb in breadcrumbs %}
    {% if not loop.last %}
    <a href="{{ crumb.link }}">{{ crumb.name }}</a>
    <span class="sep">›</span>
    {% else %}
    <span class="filename">{{ filename }}</span>
    {% endif %}
  {% endfor %}
</div>

<div class="content">

  <div class="thumb-col">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ filename }}" />
    {% else %}
    <div class="no-thumb">No preview</div>
    {% endif %}

    <div class="file-meta">
      <table>
        <tr><td>Format</td><td>{{ details.format | capitalize if details.format else '—' }}</td></tr>
        {% if details.header_text %}
        <tr><td>Header</td><td>{{ details.header_text }}</td></tr>
        {% endif %}
        <tr><td>Modified</td><td>{{ modified }}</td></tr>
        <tr><td>Size</td><td>{{ file_size }}</td></tr>
      </table>
    </div>
  </div>

  <div class="detail-col">
    <h1>{{ filename }}</h1>
    <span class="badge">STL</span>

    {% if details.error %}
    <div class="error-box">Could not parse STL: {{ details.error }}</div>
    {% else %}

    <div class="section">
      <h2>Dimensions</h2>
      <table class="dim-table">
        <thead>
          <tr><th>Axis</th><th>mm</th><th>inches</th></tr>
        </thead>
        <tbody>
          <tr><td>X (width)</td><td>{{ details.size_x_mm }}</td><td>{{ details.size_x_in }}</td></tr>
          <tr><td>Y (depth)</td><td>{{ details.size_y_mm }}</td><td>{{ details.size_y_in }}</td></tr>
          <tr><td>Z (height)</td><td>{{ details.size_z_mm }}</td><td>{{ details.size_z_in }}</td></tr>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>Mesh</h2>
      <div class="meta-grid">
        <div class="meta-stat">
          <div class="val">{{ "{:,}".format(details.triangle_count) }}</div>
          <div class="lbl">Triangles</div>
        </div>
        <div class="meta-stat">
          <div class="val">{{ "{:,}".format(details.unique_vertices) }}</div>
          <div class="lbl">Unique vertices</div>
        </div>
        <div class="meta-stat">
          <div class="val">{{ "{:,}".format(details.unique_edges) }}</div>
          <div class="lbl">Unique edges</div>
        </div>
        <div class="meta-stat">
          <div class="val">{{ details.connected_components }}</div>
          <div class="lbl">Connected components</div>
        </div>
      </div>
      <div style="margin-top:12px;font-size:13px;">
        Manifold (watertight):
        {% if details.is_manifold %}
        <span class="status-ok">Yes</span>
        {% else %}
        <span class="status-warn">No — some edges are not shared by exactly 2 faces</span>
        {% endif %}
      </div>
    </div>

    <div class="section">
      <h2>Surface area &amp; volume</h2>
      <div class="meta-grid">
        <div class="meta-stat">
          <div class="val">{{ details.surface_area_mm2 }} mm²</div>
          <div class="lbl">Surface area</div>
        </div>
        <div class="meta-stat">
          <div class="val">{{ details.surface_area_cm2 }} cm²</div>
          <div class="lbl">Surface area</div>
        </div>
        <div class="meta-stat">
          <div class="val">{{ details.volume_mm3 }} mm³</div>
          <div class="lbl">Volume</div>
        </div>
        <div class="meta-stat">
          <div class="val">{{ details.volume_cm3 }} cm³</div>
          <div class="lbl">Volume</div>
        </div>
      </div>
    </div>

    {% endif %}
  </div>
</div>

<script>
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
