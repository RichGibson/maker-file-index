<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ filename }}</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 0; background: #f5f5f5; line-height: 1.4; color: #222; }

    .topbar { background: #fff; border-bottom: 1px solid #ddd; padding: 12px 28px; display: flex; align-items: center; gap: 16px; }
    .topbar a { text-decoration: none; color: #555; font-size: 13px; }
    .topbar a:hover { text-decoration: underline; }
    .topbar .sep { color: #ccc; }
    .topbar .filename { font-weight: 600; color: #222; }

    .content { max-width: 960px; margin: 28px auto; padding: 0 24px; display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start; }

    /* Left column */
    .thumb-col {}
    .thumb-col img { width: 100%; border-radius: 10px; border: 1px solid #ddd; background: #fff; }
    .no-thumb { width: 100%; height: 260px; border-radius: 10px; border: 1px solid #ddd; background: #f6f6f6; display: flex; align-items: center; justify-content: center; color: #bbb; font-size: 14px; }

    .file-meta { margin-top: 16px; background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 14px 16px; }
    .file-meta table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .file-meta td { padding: 4px 0; vertical-align: top; }
    .file-meta td:first-child { color: #888; width: 110px; }
    .file-meta td:last-child { font-weight: 500; }

    /* Right column */
    .detail-col {}
    .detail-col h1 { margin: 0 0 4px; font-size: 1.4rem; word-break: break-all; }
    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #fff0e0; color: #b05000; margin-bottom: 16px; }

    .section { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 16px 18px; margin-bottom: 16px; }
    .section h2 { margin: 0 0 12px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #888; }

    .notes { white-space: pre-wrap; font-size: 14px; line-height: 1.6; }

    .layers-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .layers-table th { text-align: left; padding: 5px 10px 5px 0; color: #888; font-weight: 600; border-bottom: 1px solid #eee; }
    .layers-table td { padding: 6px 10px 6px 0; border-bottom: 1px solid #f3f3f3; }
    .layers-table tr:last-child td { border-bottom: none; }
    .layer-type { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 99px; }
    .type-Cut  { background: #fde8e8; color: #b91c1c; }
    .type-Scan { background: #e8f0fe; color: #1a5cbe; }
    .type-Fill { background: #e4f7e4; color: #1d7a1d; }
    .type-Image { background: #ede0ff; color: #6b21a8; }

    .shapes-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .shape-chip { background: #f3f3f3; border-radius: 6px; padding: 4px 12px; font-size: 13px; }
    .shape-chip strong { margin-left: 4px; }

    .text-list { list-style: none; margin: 0; padding: 0; }
    .text-list li { padding: 4px 0; border-bottom: 1px solid #f3f3f3; font-size: 13px; font-family: monospace; }
    .text-list li:last-child { border-bottom: none; }

    .muted { color: #aaa; font-size: 13px; }

    @media (max-width: 680px) {
      .content { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<div class="topbar">
  <a href="{{ home_link }}">&#8962; Home</a>
  <span class="sep">›</span>
  {% for crumb in breadcrumbs %}
    {% if not loop.last %}
    <a href="{{ crumb.link }}">{{ crumb.name }}</a>
    <span class="sep">›</span>
    {% else %}
    <span class="filename">{{ filename }}</span>
    {% endif %}
  {% endfor %}
</div>

<div class="content">

  <div class="thumb-col">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ filename }}" />
    {% else %}
    <div class="no-thumb">No preview</div>
    {% endif %}

    <div class="file-meta">
      <table>
        {% if details.device_name %}
        <tr><td>Machine</td><td>{{ details.device_name }}</td></tr>
        {% endif %}
        {% if details.app_version %}
        <tr><td>LightBurn</td><td>{{ details.app_version }}</td></tr>
        {% endif %}
        {% if details.material_height and details.material_height != '0' %}
        <tr><td>Material&nbsp;height</td><td>{{ details.material_height }} mm</td></tr>
        {% endif %}
        <tr><td>Modified</td><td>{{ modified }}</td></tr>
        <tr><td>Size</td><td>{{ file_size }}</td></tr>
      </table>
    </div>
  </div>

  <div class="detail-col">
    <h1>{{ filename }}</h1>
    <span class="badge">LightBurn</span>

    {% if details.notes %}
    <div class="section">
      <h2>Notes</h2>
      <div class="notes">{{ details.notes }}</div>
    </div>
    {% endif %}

    {% if details.layers %}
    <div class="section">
      <h2>Laser layers</h2>
      <table class="layers-table">
        <thead>
          <tr>
            <th>Layer</th>
            <th>Name</th>
            <th>Type</th>
            <th>Speed</th>
            <th>Power</th>
            <th>Passes</th>
          </tr>
        </thead>
        <tbody>
          {% for layer in details.layers %}
          <tr>
            <td>C{{ "%02d"|format(layer.index|int) }}</td>
            <td>{{ layer.name }}</td>
            <td><span class="layer-type type-{{ layer.type }}">{{ layer.type }}</span></td>
            <td>{{ layer.speed }} mm/s</td>
            <td>
              {% if layer.min_power == layer.max_power %}
              {{ layer.max_power }}%
              {% else %}
              {{ layer.min_power }}–{{ layer.max_power }}%
              {% endif %}
            </td>
            <td>{{ layer.passes }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if details.shape_counts %}
    <div class="section">
      <h2>Shapes</h2>
      <div class="shapes-list">
        {% for shape_type, count in details.shape_counts.items() %}
        <div class="shape-chip">{{ shape_type }}<strong>{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.text_strings %}
    <div class="section">
      <h2>Text content</h2>
      <ul class="text-list">
        {% for t in details.text_strings %}
        <li>{{ t }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

  </div>
</div>

</body>
</html>
