<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ filename }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
    :root {
      --bg: #f5f5f5; --surface: #ffffff; --surface-alt: #f3f3f3; --surface-hover: #e8e8e8;
      --border: #dddddd; --border-light: #eeeeee;
      --text: #222222; --text-dim: #444444; --text-muted: #888888; --text-faint: #aaaaaa; --text-faintest: #cccccc;
      --nav-bg: #ffffff; --nav-border: #dddddd;
      --input-bg: #ffffff; --input-border: #dddddd;
      --shadow: rgba(0,0,0,0.09);
    }
    [data-theme="dark"] {
      --bg: #18181b; --surface: #27272a; --surface-alt: #1e1e21; --surface-hover: #323236;
      --border: #3f3f46; --border-light: #2e2e33;
      --text: #f4f4f5; --text-dim: #d4d4d8; --text-muted: #a1a1aa; --text-faint: #71717a; --text-faintest: #52525b;
      --nav-bg: #1c1c1f; --nav-border: #3f3f46;
      --input-bg: #27272a; --input-border: #3f3f46;
      --shadow: rgba(0,0,0,0.4);
    }

    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 0; background: var(--bg); line-height: 1.4; color: var(--text); }

    /* Top nav */
    .topnav { background: var(--nav-bg); border-bottom: 1px solid var(--nav-border); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
    .topnav-brand { font-weight: 700; font-size: 15px; text-decoration: none; color: var(--text); }
    .topnav-right { position: relative; display: flex; align-items: center; gap: 10px; }
    .settings-btn { background: none; border: 1px solid var(--border); border-radius: 8px; padding: 5px 12px; font-size: 13px; cursor: pointer; color: var(--text-dim); }
    .settings-btn:hover { background: var(--surface-alt); }
    .settings-panel { display: none; position: absolute; right: 0; top: calc(100% + 8px); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px; box-shadow: 0 4px 20px var(--shadow); min-width: 180px; z-index: 200; }
    .settings-panel.open { display: block; }
    .settings-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 10px; }
    .theme-opt { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text); padding: 5px 0; cursor: pointer; }
    .theme-opt input { cursor: pointer; accent-color: #0099ff; }

    /* Breadcrumb bar */
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border); padding: 10px 28px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .topbar a { text-decoration: none; color: var(--text-muted); font-size: 13px; }
    .topbar a:hover { text-decoration: underline; }
    .topbar .sep { color: var(--border); }
    .topbar .filename { font-weight: 600; color: var(--text); font-size: 13px; }

    .content { max-width: 960px; margin: 28px auto; padding: 0 24px; display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start; }

    .thumb-col {}
    .thumb-col img { width: 100%; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); }
    .no-thumb { width: 100%; height: 260px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface-alt); display: flex; align-items: center; justify-content: center; color: var(--text-faintest); font-size: 14px; }

    .file-meta { margin-top: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
    .file-meta table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .file-meta td { padding: 4px 0; vertical-align: top; }
    .file-meta td:first-child { color: var(--text-muted); width: 110px; }
    .file-meta td:last-child { font-weight: 500; }

    .detail-col {}
    .detail-col h1 { margin: 0 0 4px; font-size: 1.4rem; word-break: break-all; }
    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #fff0e0; color: #b05000; margin-bottom: 16px; }

    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin-bottom: 16px; }
    .section h2 { margin: 0 0 12px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }

    .notes { white-space: pre-wrap; font-size: 14px; line-height: 1.6; }

    .layers-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .layers-table th { text-align: left; padding: 5px 10px 5px 0; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border); }
    .layers-table td { padding: 6px 10px 6px 0; border-bottom: 1px solid var(--border-light); color: var(--text); }
    .layers-table tr:last-child td { border-bottom: none; }
    .layer-type { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 99px; }
    .type-Cut   { background: #fde8e8; color: #b91c1c; }
    .type-Scan  { background: #e8f0fe; color: #1a5cbe; }
    .type-Fill  { background: #e4f7e4; color: #1d7a1d; }
    .type-Image { background: #ede0ff; color: #6b21a8; }

    .shapes-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .shape-chip { border-radius: 6px; padding: 4px 12px; font-size: 13px; }
    .shape-chip strong { margin-left: 4px; }

    .text-list { list-style: none; margin: 0; padding: 0; }
    .text-list li { padding: 4px 0; border-bottom: 1px solid var(--border-light); font-size: 13px; font-family: monospace; color: var(--text); }
    .text-list li:last-child { border-bottom: none; }

    .muted { color: var(--text-faint); font-size: 13px; }
    .layer-off { opacity: 0.45; }
    .time-summary { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 14px; }
    .time-stat { background: var(--surface-alt); border-radius: 8px; padding: 8px 14px; font-size: 13px; }
    .time-stat .val { font-size: 1.1rem; font-weight: 700; color: var(--text); }
    .time-stat .lbl { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
    .time-note { font-size: 11px; color: var(--text-faint); margin-top: 10px; }

    @media (max-width: 680px) {
      .content { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

<div class="topbar">
  {% for crumb in breadcrumbs %}
    {% if not loop.last %}
    <a href="{{ crumb.link }}">{{ crumb.name }}</a>
    <span class="sep">›</span>
    {% else %}
    <span class="filename">{{ filename }}</span>
    {% endif %}
  {% endfor %}
</div>

<div class="content">

  <div class="thumb-col">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ filename }}" />
    {% else %}
    <div class="no-thumb">No preview</div>
    {% endif %}

    <div class="file-meta">
      <table>
        {% if details.device_name %}
        <tr><td>Machine</td><td>{{ details.device_name }}</td></tr>
        {% endif %}
        {% if details.app_version %}
        <tr><td>LightBurn</td><td>{{ details.app_version }}</td></tr>
        {% endif %}
        {% if details.material_height and details.material_height != '0' %}
        <tr><td>Material&nbsp;height</td><td>{{ details.material_height }} mm</td></tr>
        {% endif %}
        {% if details.mirror_x or details.mirror_y %}
        <tr><td>Mirror</td><td>{% if details.mirror_x == 'True' %}X{% endif %}{% if details.mirror_x == 'True' and details.mirror_y == 'True' %}, {% endif %}{% if details.mirror_y == 'True' %}Y{% endif %}</td></tr>
        {% endif %}
        <tr><td>Modified</td><td>{{ modified }}</td></tr>
        <tr><td>Size</td><td>{{ file_size }}</td></tr>
      </table>
    </div>
  </div>

  <div class="detail-col">
    <h1>{{ filename }}</h1>
    <span class="badge">LightBurn</span>

    {% if details.notes %}
    <div class="section">
      <h2>Notes</h2>
      <div class="notes">{{ details.notes }}</div>
    </div>
    {% endif %}

    {% if details.text_strings %}
    <div class="section">
      <h2>Text content</h2>
      <ul class="text-list">
        {% for t in details.text_strings %}
        <li>{{ t }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if details.layers %}
    <div class="section">
      <h2>Laser layers</h2>
      <table class="layers-table">
        <thead>
          <tr>
            <th>Layer</th>
            <th>Name</th>
            <th>Type</th>
            <th>Speed</th>
            <th>Power</th>
            <th>Passes</th>
            <th>Output</th>
            <th>Priority</th>
          </tr>
        </thead>
        <tbody>
          {% for layer in details.layers %}
          <tr{% if not layer.do_output %} class="layer-off"{% endif %}>
            <td><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:{{ layer.color }};margin-right:5px;vertical-align:middle;"></span>C{{ "%02d"|format(layer.index|int) }}</td>
            <td>{{ layer.name }}</td>
            <td><span class="layer-type type-{{ layer.type }}">{{ layer.type }}</span></td>
            <td>{{ layer.speed }} mm/s</td>
            <td>
              {% if layer.min_power == layer.max_power %}
              {{ layer.max_power }}%
              {% else %}
              {{ layer.min_power }}–{{ layer.max_power }}%
              {% endif %}
            </td>
            <td>{{ layer.passes }}</td>
            <td>{% if layer.do_output %}Yes{% else %}<span style="color:var(--text-faint)">No</span>{% endif %}</td>
            <td>{{ layer.priority }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if details.shape_counts %}
    <div class="section">
      <h2>Shape counts</h2>
      <div class="shapes-list">
        {% for type, count in details.shape_counts.items() %}
        <div class="shape-chip" style="background:var(--surface-alt);color:var(--text);">{{ type }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.time_estimate and details.time_estimate.by_layer %}
    <div class="section">
      <h2>Estimated cut time</h2>
      <div class="time-summary">
        <div class="time-stat">
          <div class="val">{{ details.time_estimate.total_time or "—" }}</div>
          <div class="lbl">Estimated time</div>
        </div>
      </div>
      <table class="layers-table">
        <thead>
          <tr>
            <th>Layer</th>
            <th>Name</th>
            <th>Type</th>
            <th>Vector</th>
            <th>Raster</th>
            <th>Est. time</th>
          </tr>
        </thead>
        <tbody>
          {% for tl in details.time_estimate.by_layer %}
          <tr{% if not tl.do_output %} class="layer-off"{% endif %}>
            <td><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:{{ tl.color }};margin-right:5px;vertical-align:middle;"></span>C{{ "%02d"|format(tl.cut_index) }}</td>
            <td>{{ tl.name }}</td>
            <td>{{ tl.layer_type }}</td>
            <td>
              {% if tl.has_vector %}
                {{ tl.vector_paths }} path{% if tl.vector_paths != 1 %}s{% endif %},
                {{ "%.0f"|format(tl.vector_length_mm) }} mm,
                {{ tl.vector_corners }} corner{% if tl.vector_corners != 1 %}s{% endif %}<br>
                <span style="color:var(--text-faint);font-size:0.85em">{{ tl.vector_time }}</span>
              {% else %}—{% endif %}
            </td>
            <td>
              {% if tl.has_raster %}
                {{ tl.raster_objects }} obj, {{ tl.raster_lines }} lines<br>
                <span style="color:var(--text-faint);font-size:0.85em">{{ tl.raster_time }}</span>
              {% else %}—{% endif %}
            </td>
            <td>{% if tl.do_output %}{{ tl.layer_time }}{% else %}<span style="color:var(--text-faint)">off</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="time-note">Estimate accounts for vector path length, corner overhead, raster scan lines, and travel moves. Does not account for controller optimization or firmware acceleration curves.</div>
    </div>
    {% endif %}

    {% if details.shapes_by_layer %}
    <div class="section">
      <h2>Shapes</h2>
      <div class="shapes-list">
        {% for s in details.shapes_by_layer %}
        <div class="shape-chip" style="background:{{ s.color }};color:{{ s.text_color }};">{{ s.layer_name }}<strong> ×{{ s.count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </div>
</div>

<script>
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
