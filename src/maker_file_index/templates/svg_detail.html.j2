<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ filename }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
{% include "style.css.j2" %}
    .badge { background: #fff4e0; color: #7a4a00; }
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

<div class="topbar">
  {% for crumb in breadcrumbs %}
    {% if not loop.last %}
    <a href="{{ crumb.link }}">{{ crumb.name }}</a>
    <span class="sep">›</span>
    {% else %}
    <span class="filename">{{ filename }}</span>
    {% endif %}
  {% endfor %}
</div>

<div class="content">

  <div class="thumb-col">
    {% if thumbnail %}
    <div class="svg-preview">
      <img src="{{ thumbnail }}" alt="{{ filename }}" />
    </div>
    {% else %}
    <div class="no-thumb">No preview</div>
    {% endif %}

    <div class="file-meta">
      <table>
        {% if details.width %}
        <tr><td>Width</td><td>{{ details.width }}</td></tr>
        {% endif %}
        {% if details.height %}
        <tr><td>Height</td><td>{{ details.height }}</td></tr>
        {% endif %}
        {% if details.viewbox %}
        <tr><td>viewBox</td><td>{{ details.viewbox }}</td></tr>
        {% endif %}
        {% if details.tool %}
        <tr><td>Created&nbsp;by</td><td>{{ details.tool }}</td></tr>
        {% endif %}
        <tr><td>Modified</td><td>{{ modified }}</td></tr>
        <tr><td>Size</td><td>{{ file_size }}</td></tr>
      </table>
    </div>
  </div>

  <div class="detail-col">
    <h1>{{ filename }}</h1>
    <span class="badge">SVG</span>

    {% if details.error %}
    <div class="error-box">Could not parse SVG: {{ details.error }}</div>
    {% else %}

    {% if details.path_count > 0 %}
    <div class="section">
      <h2>Geometry</h2>
      <div class="stat-row">
        <div class="stat-box">
          <div class="val">{{ details.path_count }}</div>
          <div class="lbl">Paths</div>
        </div>
        <div class="stat-box">
          <div class="val">{{ details.closed_paths }}</div>
          <div class="lbl">Closed</div>
        </div>
        <div class="stat-box">
          <div class="val">{{ details.open_paths }}</div>
          <div class="lbl">Open</div>
        </div>
        <div class="stat-box">
          <div class="val">{{ details.total_path_length }}</div>
          <div class="lbl">Path length</div>
        </div>
      </div>
      {% if details.doc_width and details.doc_height %}
      <div class="unit-note">
        Document size: {{ details.doc_width }} × {{ details.doc_height }} {{ details.unit }}.
        Path length in SVG user units ({{ details.unit }}).
        {% if details.unit == "px" %}
        At 96 dpi: 1 px ≈ 0.264 mm.
        {% endif %}
        Closed paths are likely cuts; open paths may be scores or engrave lines.
      </div>
      {% endif %}
    </div>
    {% endif %}

    {% if details.counts %}
    <div class="section">
      <h2>Elements</h2>
      <div class="chips">
        {% for tag, count in details.counts.items() %}
        <div class="chip">{{ tag }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.groups %}
    <div class="section">
      <h2>Layers / groups</h2>
      <ul class="layers-list">
        {% for g in details.groups %}
        <li>
          {% if g.label %}<span class="layer-label">{{ g.label }}</span>{% endif %}
          {% if g.id %}<span class="layer-id">id={{ g.id }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if details.texts %}
    <div class="section">
      <h2>Text content</h2>
      <ul class="text-list">
        {% for t in details.texts %}
        <li>{{ t }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% endif %}
  </div>
</div>

<script>
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
