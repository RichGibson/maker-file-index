<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ directory_name }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
    :root {
      --bg: #f5f5f5; --surface: #ffffff; --surface-alt: #f3f3f3; --surface-hover: #e8e8e8;
      --border: #dddddd; --border-light: #eeeeee;
      --text: #222222; --text-dim: #444444; --text-muted: #888888; --text-faint: #aaaaaa; --text-faintest: #cccccc;
      --nav-bg: #ffffff; --nav-border: #dddddd;
      --sidebar-bg: #fafafa;
      --input-bg: #ffffff; --input-border: #dddddd;
      --shadow: rgba(0,0,0,0.09);
    }
    [data-theme="dark"] {
      --bg: #18181b; --surface: #27272a; --surface-alt: #1e1e21; --surface-hover: #323236;
      --border: #3f3f46; --border-light: #2e2e33;
      --text: #f4f4f5; --text-dim: #d4d4d8; --text-muted: #a1a1aa; --text-faint: #71717a; --text-faintest: #52525b;
      --nav-bg: #1c1c1f; --nav-border: #3f3f46;
      --sidebar-bg: #1e1e21;
      --input-bg: #27272a; --input-border: #3f3f46;
      --shadow: rgba(0,0,0,0.4);
    }

    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 0; background: var(--bg); line-height: 1.35; color: var(--text); }

    /* Top nav */
    .topnav { background: var(--nav-bg); border-bottom: 1px solid var(--nav-border); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
    .topnav-brand { font-weight: 700; font-size: 15px; text-decoration: none; color: var(--text); }
    .topnav-right { position: relative; display: flex; align-items: center; gap: 10px; }
    .sidebar-toggle { background: none; border: 1px solid var(--border); border-radius: 8px; padding: 5px 10px; font-size: 15px; cursor: pointer; color: var(--text-dim); line-height: 1; }
    .sidebar-toggle:hover { background: var(--surface-alt); }
    .settings-btn { background: none; border: 1px solid var(--border); border-radius: 8px; padding: 5px 12px; font-size: 13px; cursor: pointer; color: var(--text-dim); }
    .settings-btn:hover { background: var(--surface-alt); }
    .settings-panel { display: none; position: absolute; right: 0; top: calc(100% + 8px); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px; box-shadow: 0 4px 20px var(--shadow); min-width: 180px; z-index: 200; }
    .settings-panel.open { display: block; }
    .settings-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 10px; }
    .theme-opt { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text); padding: 5px 0; cursor: pointer; }
    .theme-opt input { cursor: pointer; accent-color: #0099ff; }

    h1 { margin: 0 0 6px 0; }
    .meta { color: var(--text-muted); margin-bottom: 18px; font-size: 13px; }
    .section { margin-top: 22px; }

    .breadcrumbs { font-size: 13px; color: var(--text-muted); margin-bottom: 10px; }
    .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .breadcrumbs .sep { margin: 0 5px; }
    .breadcrumbs .current { color: var(--text); font-weight: 600; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .card { border: 1px solid var(--border); border-radius: 10px; padding: 10px; background: var(--surface); }
    .card:hover { box-shadow: 0 2px 10px var(--shadow); }
    .thumb { width: 100%; height: 170px; border-radius: 8px; object-fit: contain; background: var(--surface-alt); border: 1px solid var(--border-light); }
    .no-thumb { width: 100%; height: 170px; border-radius: 8px; background: var(--surface-alt); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; color: var(--text-faintest); font-size: 13px; }
    .label { margin-top: 8px; font-size: 14px; }
    .label a { color: inherit; text-decoration: none; }
    .label a:hover { text-decoration: underline; }
    .sub { margin-top: 6px; color: var(--text-muted); font-size: 13px; }
    .notes-snippet { margin-top: 4px; font-size: 12px; color: var(--text-faint); line-height: 1.4; }
    .muted { color: var(--text-muted); font-size: 13px; }
    code { background: var(--surface-alt); padding: 2px 6px; border-radius: 6px; }

    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.03em; }
    .badge-lbrn2, .badge-lbrn { background: #fff0e0; color: #b05000; }
    .badge-stl  { background: #e0eeff; color: #1a5cbe; }
    .badge-scad { background: #e4f7e4; color: #1d7a1d; }
    .badge-3mf  { background: #ede0ff; color: #6b21a8; }
    .badge-svg  { background: #ffe0f0; color: #b0006a; }
    .badge-dxf  { background: #e0f7f7; color: #0e6868; }
    .badge-default { background: #f0f0f0; color: #555; }

    .tree { margin: 10px 0 18px 0; padding: 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--sidebar-bg); }
    .tree ul { list-style: none; margin: 6px 0 0 0; padding-left: 18px; }
    .tree li { margin: 4px 0; }
    .tree a { text-decoration: none; color: var(--text-dim); }
    .tree a:hover { text-decoration: underline; }
    .tree .current { font-weight: 700; color: var(--text); }
    .tree .toggle { cursor: pointer; user-select: none; font-size: 10px; color: var(--text-faint); margin-right: 3px; display: inline-block; width: 10px; }
    .tree .toggle:hover { color: var(--text-muted); }
    .tree .spacer { display: inline-block; width: 13px; }
    .tree li.collapsed > ul { display: none; }

    .layout { display: grid; grid-template-columns: 260px 1fr; gap: 18px; align-items: start; padding: 20px 24px; }
    .layout.sidebar-hidden { grid-template-columns: 1fr; }
    .layout.sidebar-hidden .sidebar { display: none; }
    .sidebar { position: sticky; top: 57px; max-height: calc(100vh - 73px); overflow: auto; padding: 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--sidebar-bg); }
    .main { min-width: 0; }
    .sidebar .toplink { margin-bottom: 10px; }
    .sidebar .toplink a { text-decoration: none; font-weight: 600; color: var(--text); }
    .sidebar .toplink a:hover { text-decoration: underline; }
    .filter-bar { margin-bottom: 14px; }
    .filter-bar input { width: 100%; padding: 7px 12px; border: 1px solid var(--input-border); border-radius: 8px; font-size: 14px; outline: none; background: var(--input-bg); color: var(--text); }
    .filter-bar input:focus { border-color: var(--text-muted); }
    .card.hidden { display: none; }
    .error-badge { margin-top: 6px; font-size: 11px; color: #c0392b; background: #fdf0ef; border: 1px solid #f5c6c2; border-radius: 6px; padding: 2px 7px; display: inline-block; }
    .card.has-error { border-color: #f5c6c2; }
    .type-filters { margin-bottom: 12px; }
    .type-filters .label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .type-btn { display: block; width: 100%; text-align: left; background: none; border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; margin-bottom: 4px; font-size: 13px; cursor: pointer; color: var(--text-dim); }
    .type-btn:hover { background: var(--surface-hover); }
    .type-btn.active { background: #e8f0fe; border-color: #aac4f7; color: #1a5cbe; font-weight: 600; }
    [data-theme="dark"] .type-btn.active { background: #1e3a5f; border-color: #2563ab; color: #7eb7ff; }
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="sidebar-toggle" id="sidebar-toggle-btn" onclick="toggleSidebar()" title="Toggle sidebar">&#9776;</button>
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

{% macro render_tree(nodes) -%}
<ul>
  {%- for n in nodes %}
  <li>
    {%- if n.children and n.children|length %}
    <span class="toggle" onclick="toggleTree(this)">▾</span>
    {%- else %}
    <span class="spacer"></span>
    {%- endif %}
    {%- if n.is_current %}
    <span class="current">{{ n.name }}</span>
    {%- else %}
    <a href="{{ n.link }}">{{ n.name }}</a>
    {%- endif %}
    {%- if n.children and n.children|length %}
      {{ render_tree(n.children) }}
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
{%- endmacro %}

{% macro ext_badge(ext) -%}
{%- set cls = "badge-" ~ ext if ext in ["lbrn2","lbrn","stl","scad","3mf","svg","dxf"] else "badge-default" -%}
<span class="badge {{ cls }}">{{ ext or "?" }}</span>
{%- endmacro %}

<div class="layout">

  <aside class="sidebar">
    <div class="toplink"><a href="{{ home_link }}">&#8962; Home</a></div>

    {% if page_types %}
    <div class="type-filters">
      <div class="label">File types</div>
      {% for t in page_types %}
      <button class="type-btn" data-key="{{ t.key }}" onclick="toggleType(this)">{{ t.label }}</button>
      {% endfor %}
    </div>
    {% endif %}

    {% if tree_data %}
      <div class="tree">
        {{ render_tree(tree_data) }}
      </div>
    {% else %}
      <div style="color:var(--text-faint);font-size:13px;">(no subdirectories)</div>
    {% endif %}
  </aside>

  <main class="main">

    {% if breadcrumbs %}
    <div class="breadcrumbs">
      {%- for crumb in breadcrumbs %}
        {%- if not loop.first %}<span class="sep">›</span>{% endif %}
        {%- if crumb.is_current %}
          <span class="current">{{ crumb.name }}</span>
        {%- else %}
          <a href="{{ crumb.link }}">{{ crumb.name }}</a>
        {%- endif %}
      {%- endfor %}
    </div>
    {% endif %}

    <h1>{{ directory_name }}</h1>
    <div class="meta">Generated: {{ generated_at }}</div>

    {% if subdirs or file_cards %}
    <div class="filter-bar">
      <input type="search" id="page-filter" placeholder="Filter…" oninput="filterCards(this.value)" />
    </div>
    {% endif %}

    {% if subdirs %}
    <div class="section">
      <h2>Directories</h2>
      <div class="grid" id="dir-grid">
        {% for d in subdirs %}
        <div class="card" data-name="{{ d.name | lower }}" data-labels="{{ d.labels }}">
          {% if d.first_thumb %}
            <a href="{{ d.link }}"><img class="thumb" src="{{ d.first_thumb }}" alt="" /></a>
          {% else %}
            <a href="{{ d.link }}"><div class="thumb"></div></a>
          {% endif %}
          <div class="label">
            <a href="{{ d.link }}"><strong>{{ d.name }}</strong></a>
            {% if d.counts %} <span class="muted">{{ d.counts }}</span>{% endif %}
          </div>
          {% if d.readme_title and d.readme_link %}
            <div class="sub"><a href="{{ d.readme_link }}">{{ d.readme_title }}</a></div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if file_cards %}
    <div class="section">
      <h2>Files</h2>
      <div class="grid" id="file-grid">
        {% for f in file_cards %}
        <div class="card{% if f.error %} has-error{% endif %}" data-name="{{ f.display | lower }} {{ f.ext }}" data-labels="{{ f.labels }}">
          {%- set card_link = f.detail_link if f.detail_link else f.path -%}
          {% if f.thumb %}
            <a href="{{ card_link }}"><img class="thumb" src="{{ f.thumb }}" alt="" /></a>
          {% else %}
            <a href="{{ card_link }}"><div class="no-thumb">{{ ext_badge(f.ext) }}</div></a>
          {% endif %}
          <div class="label">
            <a href="{{ card_link }}"><strong>{{ f.display }}</strong></a>
          </div>
          <div class="sub">{{ ext_badge(f.ext) }}</div>
          {% if f.notes %}
            <div class="notes-snippet">{{ f.notes }}</div>
          {% endif %}
          {% if f.error %}
            <div class="error-badge" title="{{ f.error }}">&#9888; thumbnail error</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </main>
</div>

<script>
var activeType = null;

function applyFilters() {
  var q = (document.getElementById('page-filter') ? document.getElementById('page-filter').value : '').toLowerCase().trim();
  document.querySelectorAll('#dir-grid .card, #file-grid .card').forEach(function(card) {
    var nameMatch = q === '' || card.dataset.name.includes(q);
    var typeMatch = !activeType || (card.dataset.labels || '').split(' ').includes(activeType);
    card.classList.toggle('hidden', !nameMatch || !typeMatch);
  });
}
function filterCards(q) { applyFilters(); }
function toggleType(btn) {
  var key = btn.dataset.key;
  if (activeType === key) {
    activeType = null;
    btn.classList.remove('active');
  } else {
    activeType = key;
    document.querySelectorAll('.type-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
  }
  applyFilters();
}
function toggleTree(btn) {
  var li = btn.parentElement;
  li.classList.toggle('collapsed');
  btn.textContent = li.classList.contains('collapsed') ? '▸' : '▾';
}

/* Sidebar toggle */
function toggleSidebar() {
  var layout = document.querySelector('.layout');
  layout.classList.toggle('sidebar-hidden');
  localStorage.setItem('mfi-sidebar', layout.classList.contains('sidebar-hidden') ? '0' : '1');
}
(function() {
  if (localStorage.getItem('mfi-sidebar') === '0') {
    document.querySelector('.layout').classList.add('sidebar-hidden');
  }
})();

/* Sidebar scroll persistence */
(function() {
  var sidebar = document.querySelector('.sidebar');
  if (!sidebar) return;
  var saved = sessionStorage.getItem('sidebarScroll');
  if (saved) sidebar.scrollTop = parseInt(saved, 10);
  sidebar.addEventListener('click', function() {
    sessionStorage.setItem('sidebarScroll', sidebar.scrollTop);
  });
})();

/* Theme */
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
