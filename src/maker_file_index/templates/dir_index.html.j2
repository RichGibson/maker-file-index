<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ directory_name }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
{% include "style.css.j2" %}
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="sidebar-toggle" id="sidebar-toggle-btn" onclick="toggleSidebar()">&#9776; Sidebar</button>
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

{% macro render_tree(nodes) -%}
<ul>
  {%- for n in nodes %}
  <li{% if n.children and n.children|length %} class="collapsed"{% endif %}>
    {%- if n.children and n.children|length %}
    <span class="toggle" onclick="toggleTree(this)">&#9654;</span>
    {%- else %}
    <span class="spacer"></span>
    {%- endif %}
    {%- if n.is_current %}
    <span class="current">{{ n.name }}</span>
    {%- else %}
    <a href="{{ n.link }}">{{ n.name }}</a>
    {%- endif %}
    {%- if n.children and n.children|length %}
      {{ render_tree(n.children) }}
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
{%- endmacro %}

{% macro ext_badge(ext) -%}
{%- set cls = "badge-" ~ ext if ext in ["lbrn2","lbrn","stl","scad","3mf","svg","dxf","cdr"] else "badge-default" -%}
<span class="badge {{ cls }}">{{ ext or "?" }}</span>
{%- endmacro %}

<div class="layout">

  <aside class="sidebar">
    <div class="toplink"><a href="{{ home_link }}">&#8962; Home</a></div>

    {% if page_types %}
    <div class="type-filters">
      <div class="label">File types</div>
      {% for t in page_types %}
      <button class="type-btn" data-key="{{ t.key }}" onclick="toggleType(this)">{{ t.label }}</button>
      {% endfor %}
    </div>
    {% endif %}

    {% if tree_data %}
      <div class="tree">
        {{ render_tree(tree_data) }}
      </div>
    {% else %}
      <div style="color:var(--text-faint);font-size:13px;">(no subdirectories)</div>
    {% endif %}
  </aside>

  <main class="main">

    {% if breadcrumbs %}
    <div class="breadcrumbs">
      {%- for crumb in breadcrumbs %}
        {%- if not loop.first %}<span class="sep">›</span>{% endif %}
        {%- if crumb.is_current %}
          <span class="current">{{ crumb.name }}</span>
        {%- else %}
          <a href="{{ crumb.link }}">{{ crumb.name }}</a>
        {%- endif %}
      {%- endfor %}
    </div>
    {% endif %}

    <h1>{{ readme_title if readme_title else directory_name }}</h1>
    <div class="meta">Generated: {{ generated_at }}</div>

    {% if readme_content %}
    <div class="readme-block">{{ readme_content }}</div>
    {% endif %}

    {% if subdirs or file_cards %}
    <div class="filter-sort-row">
      <input type="search" id="page-filter" placeholder="Filter…" oninput="filterCards(this.value)" />
      <div class="sort-btns">
        <button class="sort-btn" data-sort="recent" onclick="setSort('recent')">Recent</button>
        <button class="sort-btn" data-sort="alpha"  onclick="setSort('alpha')">Name</button>
      </div>
    </div>
    {% endif %}

    {% if subdirs %}
    <div class="section">
      <h2>Directories</h2>
      <div class="grid" id="dir-grid">
        {% for d in subdirs %}
        <div class="card" data-name="{{ d.name | lower }}" data-labels="{{ d.labels }}" data-mtime="{{ d.mtime }}">
          {% if d.first_thumb %}
            <a href="{{ d.link }}"><img class="thumb" src="{{ d.first_thumb }}" alt="" /></a>
          {% else %}
            <a href="{{ d.link }}"><div class="thumb"></div></a>
          {% endif %}
          <div class="label">
            <a href="{{ d.link }}"><strong>{{ d.name }}</strong></a>
            {% if d.counts %} <span class="muted">{{ d.counts }}</span>{% endif %}
          </div>
          {% if d.readme_title and d.readme_link %}
            <div class="sub"><a href="{{ d.readme_link }}">{{ d.readme_title }}</a></div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if file_cards %}
    <div class="section">
      <h2>Files</h2>
      <div class="grid" id="file-grid">
        {% for f in file_cards %}
        <div class="card{% if f.error %} has-error{% endif %}" data-name="{{ f.display | lower }} {{ f.ext }}" data-labels="{{ f.labels }}" data-mtime="{{ f.mtime }}">
          {%- set card_link = f.detail_link if f.detail_link else f.path -%}
          {% if f.thumb %}
            <a href="{{ card_link }}"><img class="thumb" src="{{ f.thumb }}" alt="" /></a>
          {% else %}
            <a href="{{ card_link }}"><div class="no-thumb">{{ ext_badge(f.ext) }}</div></a>
          {% endif %}
          <div class="label">
            <a href="{{ card_link }}"><strong>{{ f.display }}</strong></a>
          </div>
          <div class="sub">{{ ext_badge(f.ext) }}</div>
          {% if f.notes %}
            <div class="notes-snippet">{{ f.notes }}</div>
          {% endif %}
          {% if f.error %}
            <div class="error-badge" title="{{ f.error }}">&#9888; thumbnail error</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="section" id="subdir-files-section" style="display:none;">
      <h2>Files in subdirectories</h2>
      <div class="grid" id="subdir-file-grid"></div>
    </div>

  </main>
</div>

<script>
var activeType = null;
var SORT_KEY = 'mfi-sort';
var currentSort = 'recent';
var currentDir = 'desc';
(function() {
  var saved = localStorage.getItem(SORT_KEY) || 'recent-desc';
  var parts = saved.split('-');
  currentSort = parts[0] === 'alpha' ? 'alpha' : 'recent';
  currentDir = parts[1] === 'asc' ? 'asc' : (parts[1] === 'desc' ? 'desc' : (currentSort === 'recent' ? 'desc' : 'asc'));
})();

function sortLabel(key, active, dir) {
  if (!active) return key === 'recent' ? 'Recent' : 'Name';
  if (key === 'recent') return dir === 'desc' ? 'Recent \u25BC' : 'Recent \u25B2';
  return dir === 'asc' ? 'A\u2013Z \u25B2' : 'Z\u2013A \u25BC';
}

function updateSortButtons() {
  document.querySelectorAll('.sort-btn').forEach(function(b) {
    var active = b.dataset.sort === currentSort;
    b.classList.toggle('active', active);
    b.textContent = sortLabel(b.dataset.sort, active, currentDir);
  });
}

function setSort(key) {
  if (currentSort === key) {
    currentDir = currentDir === 'asc' ? 'desc' : 'asc';
  } else {
    currentSort = key;
    currentDir = key === 'recent' ? 'desc' : 'asc';
  }
  localStorage.setItem(SORT_KEY, currentSort + '-' + currentDir);
  updateSortButtons();
  ['dir-grid', 'file-grid'].forEach(function(id) { applySortToGrid(document.getElementById(id)); });
}

function applySortToGrid(grid) {
  if (!grid) return;
  var cards = Array.from(grid.querySelectorAll(':scope > .card'));
  cards.sort(function(a, b) {
    var r;
    if (currentSort === 'alpha') {
      r = (a.dataset.name || '').localeCompare(b.dataset.name || '');
    } else {
      r = parseInt(b.dataset.mtime || '0') - parseInt(a.dataset.mtime || '0');
    }
    return currentDir === 'asc' ? -r : r;
  });
  cards.forEach(function(c) { grid.appendChild(c); });
}

(function() {
  updateSortButtons();
  ['dir-grid', 'file-grid'].forEach(function(id) { applySortToGrid(document.getElementById(id)); });
})();

function applyFilters() {
  var q = (document.getElementById('page-filter') ? document.getElementById('page-filter').value : '').toLowerCase().trim();
  document.querySelectorAll('#dir-grid .card, #file-grid .card').forEach(function(card) {
    var nameMatch = q === '' || card.dataset.name.includes(q);
    var typeMatch = !activeType || (card.dataset.labels || '').split(' ').includes(activeType);
    card.classList.toggle('hidden', !nameMatch || !typeMatch);
  });
}
function filterCards(q) { applyFilters(); renderSubdirResults(q.toLowerCase().trim()); }
function toggleType(btn) {
  var key = btn.dataset.key;
  if (activeType === key) {
    activeType = null;
    btn.classList.remove('active');
  } else {
    activeType = key;
    document.querySelectorAll('.type-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
  }
  applyFilters();
}
function toggleTree(btn) {
  var li = btn.parentElement;
  li.classList.toggle('collapsed');
  btn.textContent = li.classList.contains('collapsed') ? '\u25B6' : '\u25BC';
}

/* Auto-expand the path from root down to the current directory */
(function() {
  var current = document.querySelector('.tree .current');
  if (!current) return;
  var el = current.parentElement;
  while (el && !el.classList.contains('tree')) {
    if (el.tagName === 'LI') {
      el.classList.remove('collapsed');
      var toggle = el.querySelector(':scope > .toggle');
      if (toggle) toggle.textContent = '\u25BC';
    }
    el = el.parentElement;
  }
})();

/* Sidebar toggle */
var SIDEBAR_KEY = 'mfi-sidebar-v2';
function toggleSidebar() {
  var layout = document.querySelector('.layout');
  var btn = document.getElementById('sidebar-toggle-btn');
  layout.classList.toggle('sidebar-hidden');
  var hidden = layout.classList.contains('sidebar-hidden');
  localStorage.setItem(SIDEBAR_KEY, hidden ? '0' : '1');
  if (btn) btn.classList.toggle('active', hidden);
}
(function() {
  var saved = localStorage.getItem(SIDEBAR_KEY);
  if (saved === null) { localStorage.setItem(SIDEBAR_KEY, '1'); saved = '1'; }
  if (saved === '0') {
    document.querySelector('.layout').classList.add('sidebar-hidden');
    var btn = document.getElementById('sidebar-toggle-btn');
    if (btn) btn.classList.add('active');
  }
})();

/* Sidebar scroll persistence */
(function() {
  var sidebar = document.querySelector('.sidebar');
  if (!sidebar) return;
  var saved = sessionStorage.getItem('sidebarScroll');
  if (saved) sidebar.scrollTop = parseInt(saved, 10);
  sidebar.addEventListener('click', function() {
    sessionStorage.setItem('sidebarScroll', sidebar.scrollTop);
  });
})();

/* Subdir file search */
var SUBDIR_FILES = (function() {
  try { return JSON.parse(document.getElementById('subdir-files-data').textContent); } catch(e) { return []; }
})();

function renderSubdirResults(q) {
  var section = document.getElementById('subdir-files-section');
  var grid = document.getElementById('subdir-file-grid');
  if (!q || !SUBDIR_FILES.length) { section.style.display = 'none'; grid.innerHTML = ''; return; }
  var matches = SUBDIR_FILES.filter(function(f) { return f.name.toLowerCase().includes(q); });
  if (!matches.length) { section.style.display = 'none'; grid.innerHTML = ''; return; }
  section.style.display = '';
  grid.innerHTML = matches.map(function(f) {
    var extCls = ['lbrn2','lbrn','stl','scad','3mf','svg','dxf','cdr'].includes(f.ext) ? 'badge-' + f.ext : 'badge-default';
    var thumb = f.thumb ? '<a href="' + f.link + '"><img class="thumb" src="' + f.thumb + '" alt="" /></a>'
                        : '<a href="' + f.link + '"><div class="no-thumb"><span class="badge ' + extCls + '">' + (f.ext || '?') + '</span></div></a>';
    var dirLink = '<a href="' + f.dir_link + '" style="color:var(--text-muted);font-size:12px;">' + f.dir_name + '/</a>';
    return '<div class="card">' + thumb +
      '<div class="label"><a href="' + f.link + '"><strong>' + f.name + '</strong></a></div>' +
      '<div class="sub"><span class="badge ' + extCls + '">' + (f.ext || '?') + '</span></div>' +
      '<div class="sub">' + dirLink + '</div>' +
      '</div>';
  }).join('');
}

/* Theme */
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
<script id="subdir-files-data" type="application/json">{{ subdir_files_json }}</script>
</body>
</html>
