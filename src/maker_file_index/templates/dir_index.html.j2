<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ directory_name }}</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 24px; line-height: 1.35; }
    h1 { margin: 0 0 6px 0; }
    .meta { color: #666; margin-bottom: 18px; }
    .section { margin-top: 22px; }

    /* Breadcrumbs */
    .breadcrumbs { font-size: 13px; color: #888; margin-bottom: 10px; }
    .breadcrumbs a { color: #888; text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .breadcrumbs .sep { margin: 0 5px; }
    .breadcrumbs .current { color: #333; font-weight: 600; }

    /* Grid */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
    }
    .card {
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 10px;
      background: #fff;
    }
    .thumb {
      width: 100%;
      height: 170px;
      border-radius: 8px;
      object-fit: contain;
      background: #f6f6f6;
      border: 1px solid #eee;
    }
    .no-thumb {
      width: 100%;
      height: 170px;
      border-radius: 8px;
      background: #f6f6f6;
      border: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #bbb;
      font-size: 13px;
    }
    .label { margin-top: 8px; font-size: 14px; }
    .label a { color: inherit; text-decoration: none; }
    .label a:hover { text-decoration: underline; }
    .sub { margin-top: 6px; color: #666; font-size: 13px; }
    .notes-snippet { margin-top: 4px; font-size: 12px; color: #777; line-height: 1.4; }
    .muted { color: #888; font-size: 13px; }
    code { background: #f3f3f3; padding: 2px 6px; border-radius: 6px; }

    /* File type badges */
    .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      padding: 1px 7px;
      border-radius: 99px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .badge-lbrn2, .badge-lbrn { background: #fff0e0; color: #b05000; }
    .badge-stl  { background: #e0eeff; color: #1a5cbe; }
    .badge-scad { background: #e4f7e4; color: #1d7a1d; }
    .badge-3mf  { background: #ede0ff; color: #6b21a8; }
    .badge-svg  { background: #ffe0f0; color: #b0006a; }
    .badge-dxf  { background: #e0f7f7; color: #0e6868; }
    .badge-default { background: #f0f0f0; color: #555; }

    /* Sidebar & layout */
    .tree { margin: 10px 0 18px 0; padding: 12px; border: 1px solid #ddd; border-radius: 10px; background: #fafafa; }
    .tree ul { list-style: none; margin: 6px 0 0 0; padding-left: 18px; }
    .tree li { margin: 4px 0; }
    .tree a { text-decoration: none; }
    .tree a:hover { text-decoration: underline; }
    .tree .current { font-weight: 700; color: #000; }

    .layout { display: grid; grid-template-columns: 260px 1fr; gap: 18px; align-items: start; }
    .sidebar { position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow: auto; padding: 12px; border: 1px solid #ddd; border-radius: 10px; background: #fafafa; }
    .main { min-width: 0; }
    .sidebar .toplink { margin-bottom: 10px; }
    .sidebar .toplink a { text-decoration: none; font-weight: 600; }
    .sidebar .toplink a:hover { text-decoration: underline; }
  </style>
</head>
<body>

{% macro render_tree(nodes) -%}
<ul>
  {%- for n in nodes %}
  <li>
    {%- if n.is_current %}
    <span class="current">{{ n.name }}</span>
    {%- else %}
    <a href="{{ n.link }}">{{ n.name }}</a>
    {%- endif %}
    {%- if n.children and n.children|length %}
      {{ render_tree(n.children) }}
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
{%- endmacro %}

{% macro ext_badge(ext) -%}
{%- set cls = "badge-" ~ ext if ext in ["lbrn2","lbrn","stl","scad","3mf","svg","dxf"] else "badge-default" -%}
<span class="badge {{ cls }}">{{ ext or "?" }}</span>
{%- endmacro %}

<div class="layout">

  <aside class="sidebar">
    <div class="toplink"><a href="{{ home_link }}">&#8962; Home</a></div>
    {% if tree_data %}
      <div class="tree">
        {{ render_tree(tree_data) }}
      </div>
    {% else %}
      <div style="color:#aaa;font-size:13px;">(no subdirectories)</div>
    {% endif %}
  </aside>

  <main class="main">

    {% if breadcrumbs %}
    <div class="breadcrumbs">
      {%- for crumb in breadcrumbs %}
        {%- if not loop.first %}<span class="sep">›</span>{% endif %}
        {%- if crumb.is_current %}
          <span class="current">{{ crumb.name }}</span>
        {%- else %}
          <a href="{{ crumb.link }}">{{ crumb.name }}</a>
        {%- endif %}
      {%- endfor %}
    </div>
    {% endif %}

    <h1>{{ directory_name }}</h1>
    <div class="meta">Generated: {{ generated_at }}</div>

    {% if subdirs %}
    <div class="section">
      <h2>Directories</h2>
      <div class="grid">
        {% for d in subdirs %}
        <div class="card">
          {% if d.first_thumb %}
            <a href="{{ d.link }}"><img class="thumb" src="{{ d.first_thumb }}" alt="" /></a>
          {% else %}
            <a href="{{ d.link }}"><div class="thumb"></div></a>
          {% endif %}
          <div class="label">
            <a href="{{ d.link }}"><strong>{{ d.name }}</strong></a>
            {% if d.counts %} <span class="muted">{{ d.counts }}</span>{% endif %}
          </div>
          {% if d.readme_title and d.readme_link %}
            <div class="sub"><a href="{{ d.readme_link }}">{{ d.readme_title }}</a></div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if file_cards %}
    <div class="section">
      <h2>Files</h2>
      <div class="grid">
        {% for f in file_cards %}
        <div class="card">
          {% if f.thumb %}
            <a href="{{ f.path }}"><img class="thumb" src="{{ f.thumb }}" alt="" /></a>
          {% else %}
            <a href="{{ f.path }}"><div class="no-thumb">{{ ext_badge(f.ext) }}</div></a>
          {% endif %}
          <div class="label">
            <a href="{{ f.path }}"><strong>{{ f.display }}</strong></a>
          </div>
          <div class="sub">{{ ext_badge(f.ext) }}</div>
          {% if f.notes %}
            <div class="notes-snippet">{{ f.notes }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </main>
</div>

</html>
