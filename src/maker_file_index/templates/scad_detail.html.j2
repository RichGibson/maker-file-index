<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ filename }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('mfi-theme') || 'auto';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style>
{% include "style.css.j2" %}
    .badge { background: #dcfce7; color: #166534; }
  </style>
</head>
<body>

<nav class="topnav">
  <a class="topnav-brand" href="{{ home_link }}">Maker File Index</a>
  <div class="topnav-right">
    <button class="settings-btn" onclick="toggleSettings(event)">&#9881; Settings</button>
    <div class="settings-panel" id="settings-panel">
      <div class="settings-title">Appearance</div>
      <label class="theme-opt"><input type="radio" name="theme" value="light" onchange="setTheme('light')"> &#9728; Light</label>
      <label class="theme-opt"><input type="radio" name="theme" value="dark"  onchange="setTheme('dark')">  &#9790; Dark</label>
      <label class="theme-opt"><input type="radio" name="theme" value="auto"  onchange="setTheme('auto')">  &#128187; System</label>
    </div>
  </div>
</nav>

<div class="topbar">
  {% for crumb in breadcrumbs %}
    {% if not loop.last %}
    <a href="{{ crumb.link }}">{{ crumb.name }}</a>
    <span class="sep">›</span>
    {% else %}
    <span class="filename">{{ filename }}</span>
    {% endif %}
  {% endfor %}
</div>

<div class="content">

  <div class="thumb-col">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ filename }}" />
    {% else %}
    <div class="no-thumb">No preview</div>
    {% endif %}

    <div class="file-meta">
      <table>
        <tr><td>Format</td><td>OpenSCAD</td></tr>
        {% if details.line_count %}
        <tr><td>Lines</td><td>{{ details.line_count }}</td></tr>
        {% endif %}
        <tr><td>Modified</td><td>{{ modified }}</td></tr>
        <tr><td>Size</td><td>{{ file_size }}</td></tr>
      </table>
    </div>
  </div>

  <div class="detail-col">
    <h1>{{ filename }}</h1>
    <span class="badge">OpenSCAD</span>

    {% if details.error %}
    <div class="error-box">Could not parse SCAD: {{ details.error }}</div>
    {% else %}

    <div class="section">
      <h2>Overview</h2>
      <div class="stat-row">
        <div class="stat-box">
          <div class="val">{{ details.line_count }}</div>
          <div class="lbl">Lines</div>
        </div>
        {% if details.modules %}
        <div class="stat-box">
          <div class="val">{{ details.modules | length }}</div>
          <div class="lbl">Modules</div>
        </div>
        {% endif %}
        {% if details.primitive_counts %}
        <div class="stat-box">
          <div class="val">{{ details.primitive_counts.values() | sum }}</div>
          <div class="lbl">Primitives</div>
        </div>
        {% endif %}
        {% if details.includes %}
        <div class="stat-box">
          <div class="val">{{ details.includes | length }}</div>
          <div class="lbl">Includes</div>
        </div>
        {% endif %}
      </div>
    </div>

    {% if details.includes %}
    <div class="section">
      <h2>Includes &amp; Uses</h2>
      <ul class="include-list">
        {% for inc in details.includes %}
        <li>
          <span class="include-kind">{{ inc.kind }}</span>
          <span class="include-target">&lt;{{ inc.target }}&gt;</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if details.modules %}
    <div class="section">
      <h2>Modules</h2>
      <ul class="module-list">
        {% for mod in details.modules %}
        <li>
          <span class="module-name">{{ mod.name }}</span><span class="module-params">({{ mod.parameters | join(", ") }})</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if details.assignments %}
    <div class="section">
      <h2>Parameters</h2>
      <table class="kv-table">
        <tbody>
          {% for a in details.assignments %}
          <tr>
            <td>{{ a.name }}</td>
            <td>{{ a.value }}</td>
            <td>{{ a.comment }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if details.primitive_counts %}
    <div class="section">
      <h2>Primitives</h2>
      <div class="chips">
        {% for name, count in details.primitive_counts.items() %}
        <div class="chip">{{ name }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.transform_counts %}
    <div class="section">
      <h2>Transforms</h2>
      <div class="chips">
        {% for name, count in details.transform_counts.items() %}
        <div class="chip">{{ name }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.csg_counts %}
    <div class="section">
      <h2>CSG Operations</h2>
      <div class="chips">
        {% for name, count in details.csg_counts.items() %}
        <div class="chip">{{ name }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.custom_module_calls %}
    <div class="section">
      <h2>Module Calls</h2>
      <div class="chips">
        {% for name, count in details.custom_module_calls.items() %}
        <div class="chip">{{ name }}<strong> ×{{ count }}</strong></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if details.comments %}
    <div class="section">
      <h2>Comments</h2>
      <ul class="text-list">
        {% for c in details.comments %}
        <li>{{ c }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if details.strings %}
    <div class="section">
      <h2>Strings</h2>
      <ul class="text-list">
        {% for s in details.strings %}
        <li>{{ s }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% endif %}
  </div>
</div>

<script>
function applyTheme(t) {
  var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
}
function setTheme(t) { localStorage.setItem('mfi-theme', t); applyTheme(t); }
function toggleSettings(e) {
  e.stopPropagation();
  document.getElementById('settings-panel').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('settings-panel');
  if (p && !p.contains(e.target)) p.classList.remove('open');
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
  if ((localStorage.getItem('mfi-theme') || 'auto') === 'auto') applyTheme('auto');
});
(function() {
  var saved = localStorage.getItem('mfi-theme') || 'auto';
  var r = document.querySelector('input[name="theme"][value="' + saved + '"]');
  if (r) r.checked = true;
})();
</script>
</body>
</html>
