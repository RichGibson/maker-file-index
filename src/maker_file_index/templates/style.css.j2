/* ============================================================
   maker-file-index shared stylesheet
   Included by all HTML templates via Jinja2 include
   ============================================================ */

/* --- CSS custom properties --- */
:root {
  --bg: #f5f5f5; --surface: #ffffff; --surface-alt: #f3f3f3; --surface-hover: #e8e8e8;
  --border: #dddddd; --border-light: #eeeeee;
  --text: #222222; --text-dim: #444444; --text-muted: #888888; --text-faint: #aaaaaa; --text-faintest: #cccccc;
  --nav-bg: #ffffff; --nav-border: #dddddd;
  --sidebar-bg: #fafafa;
  --input-bg: #ffffff; --input-border: #dddddd;
  --shadow: rgba(0,0,0,0.09);
}
[data-theme="dark"] {
  --bg: #18181b; --surface: #27272a; --surface-alt: #1e1e21; --surface-hover: #323236;
  --border: #3f3f46; --border-light: #2e2e33;
  --text: #f4f4f5; --text-dim: #d4d4d8; --text-muted: #a1a1aa; --text-faint: #71717a; --text-faintest: #52525b;
  --nav-bg: #1c1c1f; --nav-border: #3f3f46;
  --sidebar-bg: #1e1e21;
  --input-bg: #27272a; --input-border: #3f3f46;
  --shadow: rgba(0,0,0,0.4);
}

/* --- Reset --- */
*, *::before, *::after { box-sizing: border-box; }
body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 0; background: var(--bg); line-height: 1.4; color: var(--text); }

/* --- Top nav --- */
.topnav { background: var(--nav-bg); border-bottom: 1px solid var(--nav-border); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
.topnav-brand { font-weight: 700; font-size: 15px; text-decoration: none; color: var(--text); }
.topnav-right { position: relative; display: flex; align-items: center; gap: 10px; }
.sidebar-toggle { background: none; border: 1px solid var(--border); border-radius: 8px; padding: 5px 12px; font-size: 13px; cursor: pointer; color: var(--text-dim); }
.sidebar-toggle:hover { background: var(--surface-alt); }
.sidebar-toggle.active { background: var(--surface-alt); font-weight: 600; }
.settings-btn { background: none; border: 1px solid var(--border); border-radius: 8px; padding: 5px 12px; font-size: 13px; cursor: pointer; color: var(--text-dim); }
.settings-btn:hover { background: var(--surface-alt); }
.settings-panel { display: none; position: absolute; right: 0; top: calc(100% + 8px); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px; box-shadow: 0 4px 20px var(--shadow); min-width: 180px; z-index: 200; }
.settings-panel.open { display: block; }
.settings-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 10px; }
.theme-opt { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text); padding: 5px 0; cursor: pointer; }
.theme-opt input { cursor: pointer; accent-color: #0099ff; }

/* --- Breadcrumb bar (detail pages) --- */
.topbar { background: var(--surface); border-bottom: 1px solid var(--border); padding: 10px 28px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.topbar a { text-decoration: none; color: var(--text-muted); font-size: 13px; }
.topbar a:hover { text-decoration: underline; }
.topbar .sep { color: var(--border); }
.topbar .filename { font-weight: 600; color: var(--text); font-size: 13px; }

/* --- Breadcrumbs (directory pages) --- */
.breadcrumbs { font-size: 13px; color: var(--text-muted); margin-bottom: 10px; }
.breadcrumbs a { color: var(--text-muted); text-decoration: none; }
.breadcrumbs a:hover { text-decoration: underline; }
.breadcrumbs .sep { margin: 0 5px; }
.breadcrumbs .current { color: var(--text); font-weight: 600; }

/* --- Layout (landing + directory pages) --- */
.layout { display: grid; grid-template-columns: 300px 1fr; gap: 18px; align-items: start; padding: 20px 24px; }
.layout.sidebar-hidden { grid-template-columns: 1fr; }
.layout.sidebar-hidden .sidebar { display: none; }
.sidebar { position: sticky; top: 57px; max-height: calc(100vh - 73px); overflow: auto; padding: 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--sidebar-bg); }
.main { min-width: 0; }
.sidebar .toplink { margin-bottom: 10px; }
.sidebar .toplink a { text-decoration: none; font-weight: 600; color: var(--text); }
.sidebar .toplink a:hover { text-decoration: underline; }

/* --- Layout (detail pages) --- */
.content { max-width: 960px; margin: 28px auto; padding: 0 24px; display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start; }
.thumb-col img { width: 100%; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); }
.no-thumb { width: 100%; height: 260px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface-alt); display: flex; align-items: center; justify-content: center; color: var(--text-faintest); font-size: 14px; }
.file-meta { margin-top: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
.file-meta table { width: 100%; border-collapse: collapse; font-size: 13px; }
.file-meta td { padding: 4px 0; vertical-align: top; }
.file-meta td:first-child { color: var(--text-muted); width: 110px; }
.file-meta td:last-child { font-weight: 500; word-break: break-word; }
.detail-col h1 { margin: 0 0 4px; font-size: 1.4rem; word-break: break-all; }

/* --- Sidebar tree --- */
.tree { margin: 10px 0 4px 0; }
.tree ul { list-style: none; margin: 4px 0 0 0; padding-left: 18px; }
.tree li { margin: 4px 0; }
.tree a { text-decoration: none; color: var(--text-dim); }
.tree a:hover { text-decoration: underline; }
.tree .current { font-weight: 700; color: var(--text); }
.tree .toggle { cursor: pointer; user-select: none; font-size: 18px; color: var(--text-dim); margin-right: 4px; display: inline-block; width: 22px; text-align: center; line-height: 1; vertical-align: middle; }
.tree .toggle:hover { color: #0099ff; }
.tree .spacer { display: inline-block; width: 26px; }
.tree li.collapsed > ul { display: none; }

/* --- Type filters (sidebar) --- */
.type-filters { margin-bottom: 12px; }
.type-filters .flabel, .type-filters .label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
.type-btn { display: block; width: 100%; text-align: left; background: none; border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; margin-bottom: 4px; font-size: 13px; cursor: pointer; color: var(--text-dim); }
.type-btn:hover { background: var(--surface-hover); }
.type-btn.active { background: #e8f0fe; border-color: #aac4f7; color: #1a5cbe; font-weight: 600; }
[data-theme="dark"] .type-btn.active { background: #1e3a5f; border-color: #2563ab; color: #7eb7ff; }

/* --- Badges --- */
.badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 16px; }
/* File-type colour variants (used in grids and sidebars) */
.badge-lbrn2, .badge-lbrn { background: #fff0e0; color: #b05000; }
.badge-stl  { background: #e0eeff; color: #1a5cbe; }
.badge-scad { background: #e4f7e4; color: #1d7a1d; }
.badge-3mf  { background: #ede0ff; color: #6b21a8; }
.badge-svg  { background: #ffe0f0; color: #b0006a; }
.badge-dxf  { background: #e0f7f7; color: #0e6868; }
.badge-cdr  { background: #fde8f0; color: #990055; }
.badge-default { background: #f0f0f0; color: #555; }

/* --- Hero / stats (landing page) --- */
.hero { margin-bottom: 20px; }
.hero h1 { margin: 0 0 4px; font-size: 1.8rem; }
.hero .subtitle { color: var(--text-muted); font-size: 14px; margin-bottom: 16px; }
.stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; align-items: center; }
.stat { background: var(--surface-alt); border-radius: 8px; padding: 6px 14px; font-size: 13px; color: var(--text-dim); }
.stat strong { color: var(--text); }
.stat-btn { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 8px; padding: 6px 14px; font-size: 13px; color: var(--text-dim); cursor: pointer; }
.stat-btn:hover { background: var(--surface-hover); }
.stat-btn.active { background: #e8f0fe; border-color: #aac4f7; color: #1a5cbe; font-weight: 600; }
[data-theme="dark"] .stat-btn.active { background: #1e3a5f; border-color: #2563ab; color: #7eb7ff; }

/* --- Filter / sort row --- */
.filter-sort-row { display: flex; align-items: center; gap: 10px; margin: 14px 0; }
.filter-sort-row input { flex: 1; min-width: 0; padding: 8px 14px; border: 1px solid var(--input-border); border-radius: 8px; font-size: 14px; outline: none; background: var(--input-bg); color: var(--text); }
.filter-sort-row input:focus { border-color: var(--text-muted); }
.sort-btns { display: flex; gap: 4px; flex-shrink: 0; }
.sort-btn { background: none; border: 2px solid var(--border); border-radius: 6px; padding: 6px 14px; font-size: 13px; cursor: pointer; color: var(--text-dim); white-space: nowrap; }
.sort-btn:hover { background: var(--surface-hover); }
.sort-btn.active { background: #e8f0fe; border-color: #1a5cbe; color: #1a5cbe; font-weight: 700; }
[data-theme="dark"] .sort-btn.active { background: #1e3a5f; border-color: #7eb7ff; color: #7eb7ff; }

/* --- Cards / grid (landing + directory pages) --- */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
.card { border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: var(--surface); transition: box-shadow 0.15s; }
.card:hover { box-shadow: 0 2px 12px var(--shadow); }
.card.hidden { display: none; }
.card.has-error { border-color: #f5c6c2; }
.thumb { width: 100%; height: 170px; border-radius: 8px; object-fit: contain; background: var(--surface-alt); border: 1px solid var(--border-light); }
.no-thumb-card { width: 100%; height: 170px; border-radius: 8px; background: var(--surface-alt); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; color: var(--text-faintest); font-size: 28px; }
.card-body { margin-top: 10px; }
.card-title { font-size: 15px; font-weight: 600; }
.card-title a { color: inherit; text-decoration: none; }
.card-title a:hover { text-decoration: underline; }
.card-meta { margin-top: 4px; font-size: 12px; color: var(--text-muted); }
.label { margin-top: 8px; font-size: 14px; }
.label a { color: inherit; text-decoration: none; }
.label a:hover { text-decoration: underline; }
.sub { margin-top: 6px; color: var(--text-muted); font-size: 13px; }
.notes-snippet { margin-top: 4px; font-size: 12px; color: var(--text-faint); line-height: 1.4; }
.error-badge { margin-top: 6px; font-size: 11px; color: #c0392b; background: #fdf0ef; border: 1px solid #f5c6c2; border-radius: 6px; padding: 2px 7px; display: inline-block; }
.readme-block { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 20px; margin-bottom: 20px; font-size: 14px; line-height: 1.7; white-space: pre-wrap; color: var(--text-dim); }

/* --- File search results (landing page) --- */
#files-section { display: none; margin-bottom: 24px; }
#files-section h2 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 12px; }
#dir-results-section h2, #file-results-section h2 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 12px; }
.file-result { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; text-decoration: none; color: var(--text); }
.file-result:hover { box-shadow: 0 2px 8px var(--shadow); }
.file-result-thumb { width: 48px; height: 48px; border-radius: 6px; object-fit: contain; background: var(--surface-alt); border: 1px solid var(--border-light); flex-shrink: 0; }
.file-result-no-thumb { width: 48px; height: 48px; border-radius: 6px; background: var(--surface-alt); border: 1px solid var(--border-light); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.file-result-info { min-width: 0; }
.file-result-name { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.file-result-dir { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.no-results { color: var(--text-muted); font-size: 14px; padding: 8px 0; }

/* --- Sections (detail pages) --- */
.section { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin-bottom: 16px; }
.section h2 { margin: 0 0 12px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
h1 { margin: 0 0 6px 0; }
.meta { color: var(--text-muted); margin-bottom: 18px; font-size: 13px; }
.muted { color: var(--text-muted); font-size: 13px; }
code { background: var(--surface-alt); padding: 2px 6px; border-radius: 6px; }
.note { font-size: 13px; color: var(--text-muted); line-height: 1.6; }

/* --- Error box --- */
.error-box { background: #fff0f0; border: 1px solid #fca5a5; border-radius: 8px; padding: 12px 16px; font-size: 13px; color: #b91c1c; }
[data-theme="dark"] .error-box { background: #2d1515; border-color: #7f1d1d; color: #fca5a5; }

/* --- Stat boxes (detail pages) --- */
.meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.meta-stat { background: var(--surface-alt); border-radius: 8px; padding: 10px 14px; }
.meta-stat .val { font-size: 1.05rem; font-weight: 700; color: var(--text); }
.meta-stat .lbl { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
.stat-row { display: flex; gap: 12px; flex-wrap: wrap; }
.stat-box { background: var(--surface-alt); border-radius: 8px; padding: 10px 14px; min-width: 90px; }
.stat-box .val { font-size: 1.05rem; font-weight: 700; color: var(--text); }
.stat-box .lbl { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }

/* --- Tables (detail pages) --- */
.dim-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.dim-table th { text-align: left; padding: 5px 10px 5px 0; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border); }
.dim-table td { padding: 6px 10px 6px 0; border-bottom: 1px solid var(--border-light); color: var(--text); }
.dim-table tr:last-child td { border-bottom: none; }
.dim-table td:not(:first-child) { font-weight: 500; font-variant-numeric: tabular-nums; }

.kv-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.kv-table th { text-align: left; padding: 5px 10px 5px 0; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border); }
.kv-table td { padding: 5px 8px 5px 0; border-bottom: 1px solid var(--border-light); vertical-align: top; }
.kv-table tr:last-child td { border-bottom: none; }
.kv-table td:first-child { color: var(--text-muted); width: 44%; }
.kv-table td:last-child { font-weight: 500; font-variant-numeric: tabular-nums; }

.layers-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.layers-table th { text-align: left; padding: 5px 10px 5px 0; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border); }
.layers-table td { padding: 6px 10px 6px 0; border-bottom: 1px solid var(--border-light); color: var(--text); }
.layers-table tr:last-child td { border-bottom: none; }

/* --- Chips (detail pages) --- */
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { background: var(--surface-alt); border-radius: 6px; padding: 4px 12px; font-size: 13px; color: var(--text); }
.chip strong { margin-left: 4px; }

/* --- Lists (detail pages) --- */
.text-list { list-style: none; margin: 0; padding: 0; }
.text-list li { padding: 4px 0; border-bottom: 1px solid var(--border-light); font-size: 13px; font-family: monospace; color: var(--text); }
.text-list li:last-child { border-bottom: none; }
.parts-list { list-style: none; margin: 0; padding: 0; }
.parts-list li { padding: 5px 0; border-bottom: 1px solid var(--border-light); font-size: 13px; }
.parts-list li:last-child { border-bottom: none; }

/* --- LightBurn-specific --- */
.notes { white-space: pre-wrap; font-size: 14px; line-height: 1.6; }
.layer-type { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 99px; }
.type-Cut   { background: #fde8e8; color: #b91c1c; }
.type-Scan  { background: #e8f0fe; color: #1a5cbe; }
.type-Fill  { background: #e4f7e4; color: #1d7a1d; }
.type-Image { background: #ede0ff; color: #6b21a8; }
.shapes-list { display: flex; flex-wrap: wrap; gap: 8px; }
.shape-chip { border-radius: 6px; padding: 4px 12px; font-size: 13px; }
.shape-chip strong { margin-left: 4px; }
.layer-off { opacity: 0.45; }
.time-summary { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 14px; }
.time-stat { background: var(--surface-alt); border-radius: 8px; padding: 8px 14px; font-size: 13px; }
.time-stat .val { font-size: 1.1rem; font-weight: 700; color: var(--text); }
.time-stat .lbl { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
.time-note { font-size: 11px; color: var(--text-faint); margin-top: 10px; }

/* --- STL / 3MF-specific --- */
.status-ok   { color: #1d7a1d; font-weight: 600; }
.status-warn { color: #b45309; font-weight: 600; }

/* --- SVG-specific --- */
.svg-preview { width: 100%; border-radius: 10px; border: 1px solid var(--border); background: #ffffff; display: block; overflow: hidden; }
.svg-preview img { width: 100%; height: auto; display: block; }
.layers-list { list-style: none; margin: 0; padding: 0; }
.layers-list li { padding: 5px 0; border-bottom: 1px solid var(--border-light); font-size: 13px; display: flex; gap: 8px; align-items: baseline; }
.layers-list li:last-child { border-bottom: none; }
.layer-id { color: var(--text-faint); font-size: 11px; font-family: monospace; }
.layer-label { color: var(--text); font-weight: 500; }
.unit-note { font-size: 11px; color: var(--text-faint); margin-top: 8px; }

/* --- DXF-specific --- */
.color-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 2px; border: 1px solid rgba(0,0,0,0.15); margin-right: 6px; vertical-align: middle; }

/* --- SCAD-specific --- */
.module-list { list-style: none; margin: 0; padding: 0; }
.module-list li { padding: 5px 0; border-bottom: 1px solid var(--border-light); font-size: 13px; font-family: monospace; color: var(--text); }
.module-list li:last-child { border-bottom: none; }
.module-name { font-weight: 700; color: var(--text); }
.module-params { color: var(--text-muted); }
.include-list { list-style: none; margin: 0; padding: 0; }
.include-list li { padding: 4px 0; border-bottom: 1px solid var(--border-light); font-size: 13px; }
.include-list li:last-child { border-bottom: none; }
.include-kind { font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-right: 6px; }
.include-target { font-family: monospace; color: var(--text); }

/* --- Footer --- */
.footer { text-align: center; color: var(--text-faint); font-size: 12px; padding: 24px; }

/* --- Responsive --- */
@media (max-width: 680px) {
  .content { grid-template-columns: 1fr; }
  .meta-grid { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  .content { grid-template-columns: 1fr; }
}
